# BondBack Backend Environment Configuration
# Copy this file to .env and fill in your keys

# ─── AI API Keys ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Which model to prefer: "anthropic" | "openai" | "mock" (offline/demo mode)
AI_PROVIDER=mock

# ─── API Security ─────────────────────────────────────────────────────────────
# Secret used to sign internal JWTs for session tokens
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Internal API key for frontend ↔ backend auth (set same in bondback/.env.local)
INTERNAL_API_KEY=bondback-dev-api-key-change-in-production

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_ANALYZE=20/minute
RATE_LIMIT_GLOBAL=200/minute

# ─── File Upload Limits ───────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/heic,application/pdf,text/plain

# ─── Storage ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
LOG_DIR=./logs

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=DEBUG
